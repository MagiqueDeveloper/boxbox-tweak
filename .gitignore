# ─── Build output ────────────────────────────────────────────────────────────
build/
DerivedData/
*.dSYM/
*.xcarchive/

# Generated by xcodegen — regenerate with `make project`.
BoxBox.xcodeproj/

# ─── Inputs and staged bundles (large binaries, never committed) ─────────────
# Drop the decrypted IPA you are tweaking into vendor/.
vendor/*
!vendor/.gitkeep

*.ipa
*.app/
Payload/

# ─── Injection artefacts ─────────────────────────────────────────────────────
*.bak
*-injected.ipa

# ─── Xcode user state ────────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# ─── Tooling ─────────────────────────────────────────────────────────────────
# Local opencode workspace; the same skills live in the user's global config.
.opencode/

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
